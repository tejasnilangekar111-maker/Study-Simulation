# Copy this file to .env and fill in real values before running
# `docker compose up` for a production (or any non-local) deployment.
# .env is gitignored — never commit real secrets.

# --- Database ---
DB_USERNAME=postgres
DB_PASSWORD=

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=

# --- AI (optional) ---
# Leave blank to use the built-in stub AI responses instead of real OpenAI calls.
OPENAI_API_KEY=

# --- Mail (required for forgot-password emails to actually send) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Admin notifications ---
# Leave blank to disable. If set, this address gets an email every time a new user registers.
ADMIN_NOTIFICATION_EMAIL=

# --- Frontend origin (CORS + password-reset links) ---
FRONTEND_ORIGIN=http://localhost:8081
